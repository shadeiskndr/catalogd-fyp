{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!dist",
      "!build",
      "!out",
      "!coverage",
      "!public",
      "!convex/_generated",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noEmptyInterface": "on",
        "noArrayIndexKey": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": {
            "allowExportNames": [
              "metadata",
              "generateMetadata",
              "viewport",
              "generateViewport",
              "generateStaticParams",
              "generateImageMetadata",
              "alt",
              "size",
              "contentType",
              "dynamic",
              "dynamicParams",
              "revalidate",
              "fetchCache",
              "runtime",
              "preferredRegion",
              "maxDuration"
            ]
          }
        }
      },
      "performance": {
        "noImgElement": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "attributes": ["className", "class"],
            "functions": ["clsx", "cva", "cn", "tw", "twMerge"]
          }
        }
      }
    },
    "domains": {
      "next": "all",
      "react": "all"
    }
  },
  "overrides": [
    {
      "includes": ["convex/**"],
      "plugins": [
        "./biome-plugins/convex-require-args-validator.grit",
        "./biome-plugins/convex-no-old-registered-function-syntax.grit",
        "./biome-plugins/convex-explicit-table-ids.grit",
        "./biome-plugins/convex-no-filter-in-query.grit",
        "./biome-plugins/convex-no-collect-in-query.grit",
        "./biome-plugins/convex-no-top-of-hour-crons.grit"
      ]
    }
  ]
}
